+@builtin
+def sched_barrier(*tensors, memory=False, _semantic=None):
+    """A dev op that places a scheduling barrier between tensor values.
+
+    Returns the input tensor when given one tensor, or a tuple of tensors
+    when given multiple tensors. Set :code:`memory=True` to order memory
+    operations across the barrier as well.
+
+    :param tensors: One or more tensors whose values cross the barrier.
+    :type tensors: tl.tensor
+    :param memory: Whether the barrier also orders memory operations.
+    :type memory: bool
+    """
+    memory = _unwrap_if_constexpr(memory)
+    return _semantic.sched_barrier(tensors, memory)
