@@ -666,6 +666,35 @@ def TT_AllocScratchOp : TT_Op<"alloc_scratch"> {
     let hasVerifier = 1;
 }
 
+// Scheduling barrier for values live across compiler scheduling boundaries.
+def TT_SchedBarrierOp : TT_Op<"sched_barrier",
+                              [DeclareOpInterfaceMethods<
+                                  MemoryEffectsOpInterface>]> {
+    let summary = "preserve a scheduling boundary between tensor values";
+    let description = [{
+      Returns each tensor operand unchanged and prevents computations using
+      the results from being scheduled before the barrier. This frontend
+      operation is a dev op; downstream compiler passes can insert
+      the corresponding formal scheduling barrier automatically.
+
+      The optional `memory` attribute requests ordering of memory operations
+      in addition to the value dependencies.
+    }];
+
+    let arguments = (ins Variadic<TT_Tensor>:$inputs,
+                         OptionalAttr<UnitAttr>:$memory);
+    let results = (outs Variadic<TT_Tensor>:$results);
+    let builders = [
+      OpBuilder<(ins "ValueRange":$inputs, "bool":$memory), [{
+        build($_builder, $_state, inputs.getTypes(), inputs);
+        if (memory)
+          $_state.addAttribute("memory", $_builder.getUnitAttr());
+      }]>
+    ];
+    let assemblyFormat = "$inputs attr-dict `:` functional-type($inputs, $results)";
+    let hasVerifier = 1;
+}
+
