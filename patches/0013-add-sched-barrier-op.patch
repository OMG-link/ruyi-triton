--- a/lib/Dialect/Triton/IR/Ops.cpp
+++ b/lib/Dialect/Triton/IR/Ops.cpp
@@ -205,6 +205,29 @@ LogicalResult AllocScratchOp::verify() {
   return success();
 }
 
+LogicalResult SchedBarrierOp::verify() {
+  if (getInputs().empty())
+    return emitOpError("requires at least one tensor operand");
+  if (getInputs().size() != getResults().size())
+    return emitOpError("must have one result for each input");
+  for (auto [input, result] : llvm::zip(getInputs(), getResults())) {
+    if (input.getType() != result.getType())
+      return emitOpError("result types must match input types");
+  }
+  return success();
+}
+
+void SchedBarrierOp::getEffects(
+    SmallVectorImpl<SideEffects::EffectInstance<MemoryEffects::Effect>>
+        &effects) {
+  effects.emplace_back(MemoryEffects::Write::get(),
+                       SchedBarrierResource::get());
+  if (getMemory()) {
+    effects.emplace_back(MemoryEffects::Read::get(), GlobalMemory::get());
+    effects.emplace_back(MemoryEffects::Write::get(), GlobalMemory::get());
+  }
+}
