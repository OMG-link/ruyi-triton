+    def sched_barrier(self, tensors, memory: bool):
+        if not tensors:
+            raise ValueError("sched_barrier requires at least one tensor")
+        if not isinstance(memory, bool):
+            raise ValueError(f"sched_barrier memory must be a bool, got {memory}")
+        for value in tensors:
+            if not isinstance(value, tl.tensor):
+                raise TypeError(f"sched_barrier arguments must be tensors, got {type(value).__name__}")
+        results = self.builder.create_sched_barrier([value.handle for value in tensors], memory)
+        wrapped = tuple(self.tensor(value, tensor.type) for value, tensor in zip(results, tensors))
+        return wrapped[0] if len(wrapped) == 1 else wrapped
+
