diff --git a/python/triton/language/semantic.py b/python/triton/language/semantic.py
index 1f12927ca4..4e9dbdf83b 100644
--- a/python/triton/language/semantic.py
+++ b/python/triton/language/semantic.py
@@ -46,6 +46,24 @@ class TritonSemantic(Generic[TensorTy]):
             raise ValueError(f"num_programs axis must be 0, 1, or 2 but got {axis}")
         return self.tensor(self.builder.create_get_num_programs(axis), tl.int32)
 
+    def alloc_scratch(self, shape, dtype: tl.dtype, alignment) -> TensorTy:
+        if isinstance(shape, int):
+            shape = [shape]
+        numel = 1
+        for d in shape:
+            if not isinstance(d, int) or d <= 0:
+                raise ValueError(f"alloc_scratch shape must contain positive constant integers, got {shape}")
+            numel *= d
+        if not isinstance(dtype, tl.dtype) or dtype.is_ptr() or not (dtype.is_int() or dtype.is_floating()):
+            raise ValueError(f"alloc_scratch dtype must be a scalar integer or float type, got {dtype}")
+        if alignment is None:
+            alignment = max(64, dtype.primitive_bitwidth // 8)
+        if not isinstance(alignment, int) or alignment <= 0 or alignment & (alignment - 1):
+            raise ValueError(f"alloc_scratch alignment must be a positive power of two, got {alignment}")
+        ptr_ty = tl.pointer_type(dtype)
+        return self.tensor(
+            self.builder.create_alloc_scratch(ptr_ty.to_ir(self.builder), numel, alignment), ptr_ty)
+
