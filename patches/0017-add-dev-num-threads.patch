+
+@builtin
+def num_threads(_semantic=None):
+    """A dev op that returns the number of threads of a program instance.
+
+    It is the kernel's resolved ``num_warps``, as a :code:`tl.constexpr`:
+    the threads a :code:`tl.dev.parallel` loop is distributed over, for
+    sizing per-thread buffers and splitting work by thread, e.g.
+    ``for t in tl.dev.parallel(0, tl.dev.num_threads())``. It is a compile-time
+    value; a different ``num_warps`` recompiles the kernel.
+    """
+    return constexpr(_semantic.builder.options.num_warps)
 
 
