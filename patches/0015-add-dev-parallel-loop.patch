diff --git a/python/triton/language/dev.py b/python/triton/language/dev.py
index 17dece2346..232cbd792c 100644
--- a/python/triton/language/dev.py
+++ b/python/triton/language/dev.py
@@ -9,10 +9,52 @@ implement them accept them.
 
 import builtins
 
-from .core import _unwrap_if_constexpr, builtin
+from .core import _unwrap_if_constexpr, base_value, builtin, constexpr
 from .core import tuple as _tl_tuple
 
-__all__ = ["alloc", "sched_barrier", "shuffle"]
+__all__ = ["alloc", "parallel", "sched_barrier", "shuffle"]
+
+
+class parallel(base_value):
+    """Loop whose iterations are independent, run by the threads of the program.
+
+    .. highlight:: python
+    .. code-block:: python
+
+        @triton.jit
+        def kernel(...):
+            for i in tl.dev.parallel(0, N, BLOCK):
+                ...
+
+    Used like :code:`tl.range`. The iterations may run in any order and
+    concurrently: the backend distributes them over the threads of the program
+    instance (``num_warps`` on the CPU backend), and the code after the loop
+    starts when all of them are done. Values defined before the loop are
+    shared by the iterations; values defined in the body belong to one
+    iteration. The body must not assign to a variable defined before the loop
+    (there is no value to carry from one iteration to the next), and writes of
+    different iterations to the same memory race. The loop becomes an
+    ``scf.forall`` without shared outputs.
+
+    :param arg1: the start value, or the end value if ``arg2`` is not given.
+    :param arg2: the end value.
+    :param step: the step value, a positive integer.
+    """
+
+    def __init__(self, arg1, arg2=None, step=None):
+        self.step = constexpr(1) if step is None else step
+        if arg2 is None:
+            self.start = constexpr(0)
+            self.end = arg1
+        else:
+            self.start = arg1
+            self.end = arg2
+
+    def __iter__(self):
+        raise RuntimeError("tl.dev.parallel can only be used in @triton.jit'd functions")
+
+    def __next__(self):
+        raise RuntimeError("tl.dev.parallel can only be used in @triton.jit'd functions")
 
 
 @builtin
