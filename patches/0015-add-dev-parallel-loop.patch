@@ -1338,6 +1340,51 @@ class CodeGenerator(ast.NodeVisitor):
             assert False, "Don't know what to do with else after for"
             ast.NodeVisitor.generic_visit(self, stmt)
 
+    def _visit_parallel_for(self, node, iterator):
+        """A tl.dev.parallel loop: an scf.forall without shared outputs."""
+        if node.orelse:
+            raise self._unsupported(node, "tl.dev.parallel loops cannot have an else clause")
+        if _is_constexpr(iterator.step) and iterator.step.value <= 0:
+            raise self._unsupported(node, "tl.dev.parallel needs a positive step")
+        lb = self.semantic.to_tensor(iterator.start)
+        ub = self.semantic.to_tensor(iterator.end)
+        step = self.semantic.to_tensor(iterator.step)
+        if not lb.dtype.is_int() or not ub.dtype.is_int() or not step.dtype.is_int():
+            raise TypeError(f"tl.dev.parallel bounds and step must all be ints, are "
+                            f"({lb.dtype}, {ub.dtype}, {step.dtype})")
+        for name, value in (("lower bound", lb), ("upper bound", ub), ("step", step)):
+            if _is_non_scalar_tensor(value):
+                raise TypeError(f"tl.dev.parallel {name} must be a scalar, got {value.type}")
+        iv_type = self.semantic.integer_promote_impl(lb.dtype, ub.dtype)
+        iv_type = self.semantic.integer_promote_impl(iv_type, step.dtype)
+        iv_ir_type = iv_type.to_ir(self.builder)
+        iv_is_signed = iv_type.int_signedness == language.core.dtype.SIGNEDNESS.SIGNED
+        lb = self.builder.create_int_cast(lb.handle, iv_ir_type, iv_is_signed)
+        ub = self.builder.create_int_cast(ub.handle, iv_ir_type, iv_is_signed)
+        step = self.builder.create_int_cast(step.handle, iv_ir_type, iv_is_signed)
+        iv_placeholder = self.builder.create_poison(iv_ir_type)
+        self.set_value(node.target.id, language.core.tensor(iv_placeholder, iv_type))
+
+        with enter_sub_region(self) as sr:
+            liveins, _ = sr
+            ip, last_loc = self._get_insertion_point_and_loc()
+            names, _, _ = self._find_carries(node, liveins, ignore={node.target.id})
+            if names:
+                raise self._unsupported(
+                    node, "the iterations of a tl.dev.parallel loop are independent: the body "
+                    f"must not assign to {', '.join(names)}, defined before the loop")
+            self._set_insertion_point_and_loc(ip, last_loc)
+            forall_op = self.builder.create_forall_op(lb, ub, step)
+            body = forall_op.get_forall_body()
+            self.scf_stack.append(node)
+            self.builder.set_insertion_point_to_start(body)
+            iv = self.builder.create_index_cast(forall_op.get_induction_var(), iv_ir_type)
+            iv_placeholder.replace_all_uses_with(iv)
+            self.set_value(node.target.id, language.core.tensor(iv, iv_type))
+            self._maybe_set_loc_to_name(iv, node.target.id)
+            self.visit_compound_statement(node.body)
+            self.scf_stack.pop()
+
     def visit_Slice(self, node):
