@@ -8,11 +8,27 @@ implement them accept them.
 """
 
 import builtins
+import warnings
 
 from .core import _unwrap_if_constexpr, base_value, builtin, constexpr
 from .core import tuple as _tl_tuple
 
-__all__ = ["alloc", "current_cpu", "num_threads", "os_thread_id", "parallel", "sched_barrier", "shuffle"]
+__all__ = ["alloc", "current_cpu", "num_threads", "os_thread_id", "parallel", "sched_barrier", "shuffle",
+           "warp_id"]
+
+
+@builtin
+def warp_id(_semantic=None):
+    """A dev op that returns the warp running the current tl.dev.parallel iteration.
+
+    An int32 in ``[0, tl.dev.num_threads())``, valid only inside a
+    :code:`tl.dev.parallel` loop. A warp runs one iteration at a time and
+    finishes it before it is given another, so per-warp resources indexed by
+    it (a row of per-warp scratch, the warp's scratchpad share) belong to the
+    iteration while it runs. On the CPU backend a warp is one CPU of the
+    program instance's slot and the value is its position in the slot.
+    """
+    return _semantic.dev_warp_id()
 
 
 @builtin
@@ -30,21 +46,31 @@ def num_threads(_semantic=None):
 
 @builtin
 def current_cpu(_semantic=None):
-    """A dev op that returns the CPU the executing thread runs on, as int32.
+    """Deprecated: for debugging tl.dev.parallel only, not for real kernels.
+
+    A dev op that returns the CPU the executing thread runs on, as int32.
 
     Inside a :code:`tl.dev.parallel` loop it is the CPU of the thread that
     runs the iteration. For inspecting where a kernel runs; -1 if unknown.
     """
+    warnings.warn("tl.dev.current_cpu is deprecated; it is for debugging tl.dev.parallel only "
+                  "(use tl.dev.warp_id to index per-warp resources)", DeprecationWarning,
