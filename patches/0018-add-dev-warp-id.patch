     """
+    warnings.warn("tl.dev.os_thread_id is deprecated; it is for debugging tl.dev.parallel only "
+                  "(use tl.dev.warp_id to index per-warp resources)", DeprecationWarning,
+                  stacklevel=2)
     return _semantic.dev_os_thread_id()
 
 
