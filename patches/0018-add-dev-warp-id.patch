+def TT_DevWarpIdOp
+    : TT_Op<"dev.warp_id", [DeclareOpInterfaceMethods<MemoryEffectsOpInterface>]> {
+    let summary = "the warp running the current iteration of a parallel loop";
+    let description = [{
+      Inside a tl.dev.parallel loop (an scf.forall), returns as i32 the
+      index, in [0, num_warps), of the warp that runs the current iteration.
+      A warp runs one iteration at a time and finishes it before it is given
+      another, so warp-indexed resources (per-warp scratch, the warp's
+      scratchpad share) are private to the iteration while it runs.
+    }];
+    let results = (outs I32:$result);
+    let assemblyFormat = "attr-dict `:` type($result)";
+    let hasVerifier = 1;
+}
+
