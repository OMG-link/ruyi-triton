+// The executing thread's identity (CPU, OS thread). Queries of it write the
+// resource so that no pass merges or hoists them: their value depends on the
+// thread that runs them. No other op touches it.
+struct ThreadIdentityResource
+    : public SideEffects::Resource::Base<ThreadIdentityResource> {
+  StringRef getName() { return "<ThreadIdentityResource>"; }
+  StringRef getName() const { return "<ThreadIdentityResource>"; }
+};
