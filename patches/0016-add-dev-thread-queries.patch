+__all__ = ["alloc", "current_cpu", "os_thread_id", "parallel", "sched_barrier", "shuffle"]
+
+
+@builtin
+def current_cpu(_semantic=None):
+    """A dev op that returns the CPU the executing thread runs on, as int32.
+
+    Inside a :code:`tl.dev.parallel` loop it is the CPU of the thread that
+    runs the iteration. For inspecting where a kernel runs; -1 if unknown.
+    """
+    return _semantic.dev_current_cpu()
+
+
+@builtin
+def os_thread_id(_semantic=None):
+    """A dev op that returns the operating system id of the executing thread.
+
+    Inside a :code:`tl.dev.parallel` loop it is the thread that runs the
+    iteration. For inspecting where a kernel runs (Linux: ``gettid``).
+    """
+    return _semantic.dev_os_thread_id()
 
 
