+    let summary = "query the " # what # " of the executing thread";
+    let description = [{
+      Returns the }] # what # [{ of the thread that executes the op, as i32.
+      Two queries are never merged or moved across loops, because their
+      values depend on the thread that runs them. This frontend operation is
+      a dev op for inspecting where a kernel runs; the backend lowers it to a
