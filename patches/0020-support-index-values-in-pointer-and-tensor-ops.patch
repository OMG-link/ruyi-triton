+// -----
+
+// Layout conversion must preserve index elements while assigning encodings.
+// CHECK-LABEL: @index_shape_layout
+// CHECK: ttg.convert_layout {{.*}} : tensor<2xindex,
+// CHECK: tt.expand_dims {{.*}} : tensor<2xindex, {{.*}}> -> tensor<2x1xindex,
+// CHECK: tt.broadcast {{.*}} : tensor<2x1xindex, {{.*}}> -> tensor<2x4xindex,
+tt.func @index_shape_layout(%indices: tensor<2xindex>) -> tensor<2x4xindex> {
+  %expanded = tt.expand_dims %indices {axis = 1 : i32} : tensor<2xindex> -> tensor<2x1xindex>
+  %broadcast = tt.broadcast %expanded : tensor<2x1xindex> -> tensor<2x4xindex>
+  tt.return %broadcast : tensor<2x4xindex>
+}
