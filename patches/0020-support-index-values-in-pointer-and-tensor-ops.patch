+
+// Index displacements are signed element offsets. Shape operations preserve
+// index values without introducing an integer cast.
+// CHECK-LABEL: @index_pointer_and_shape_ops
+// CHECK-SAME: %[[BASE:[a-zA-Z0-9_]+]]: !tt.ptr<f32>, %[[X:[a-zA-Z0-9_]+]]: index, %[[OFFSETS:[a-zA-Z0-9_]+]]: tensor<2xindex>
+tt.func @index_pointer_and_shape_ops(%base: !tt.ptr<f32>, %x: index, %offsets: tensor<2xindex>) -> (!tt.ptr<f32>, tensor<2x4x!tt.ptr<f32>>) {
+  // CHECK: %[[SCALAR:.*]] = tt.addptr %[[BASE]], %[[X]] : !tt.ptr<f32>, index
+  %scalar = tt.addptr %base, %x : !tt.ptr<f32>, index
+  // CHECK: %[[EXPAND:.*]] = tt.expand_dims %[[OFFSETS]] {axis = 1 : i32} : tensor<2xindex> -> tensor<2x1xindex>
+  %expand = tt.expand_dims %offsets {axis = 1 : i32} : tensor<2xindex> -> tensor<2x1xindex>
+  // CHECK: %[[BROADCAST:.*]] = tt.broadcast %[[EXPAND]] : tensor<2x1xindex> -> tensor<2x4xindex>
+  %broadcast = tt.broadcast %expand : tensor<2x1xindex> -> tensor<2x4xindex>
+  // CHECK: tt.splat %[[X]] : index -> tensor<2x4xindex>
+  %splat = tt.splat %x : index -> tensor<2x4xindex>
+  %sum = arith.addi %broadcast, %splat : tensor<2x4xindex>
+  %bases = tt.splat %base : !tt.ptr<f32> -> tensor<2x4x!tt.ptr<f32>>
+  // CHECK: tt.addptr {{.*}} : tensor<2x4x!tt.ptr<f32>>, tensor<2x4xindex>
+  %ptrs = tt.addptr %bases, %sum : tensor<2x4x!tt.ptr<f32>>, tensor<2x4xindex>
+  tt.return %scalar, %ptrs : !tt.ptr<f32>, tensor<2x4x!tt.ptr<f32>>
+}
+
+// Exercise scalar extraction, reshape, and transpose on index values.
+// CHECK-LABEL: @index_common_types
+tt.func @index_common_types(%value: index, %values: tensor<2x2xindex>) -> (index, tensor<4xindex>, tensor<2x2xindex>) {
+  %splat = tt.splat %value : index -> tensor<1xindex>
+  // CHECK: tt.unsplat {{.*}} : tensor<1xindex>
+  %scalar = tt.unsplat %splat : tensor<1xindex>
+  // CHECK: tt.reshape {{.*}} : tensor<2x2xindex> -> tensor<4xindex>
+  %flat = tt.reshape %values : tensor<2x2xindex> -> tensor<4xindex>
+  // CHECK: tt.trans {{.*}} {order = array<i32: 1, 0>} : tensor<2x2xindex> -> tensor<2x2xindex>
+  %transposed = tt.trans %values {order = array<i32: 1, 0>} : tensor<2x2xindex> -> tensor<2x2xindex>
+  tt.return %scalar, %flat, %transposed : index, tensor<4xindex>, tensor<2x2xindex>
+}
