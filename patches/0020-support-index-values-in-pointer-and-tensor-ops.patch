+  %expand = tt.expand_dims %splat {axis = 1 : i32} : tensor<2xindex> -> tensor<2x1xindex>
+  %broadcast = tt.broadcast %expand : tensor<2x1xindex> -> tensor<2x4xindex>
+  tt.return %broadcast : tensor<2x4xindex>
+}
