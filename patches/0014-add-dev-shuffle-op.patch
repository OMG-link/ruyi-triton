 // Scheduling barrier for values live across compiler scheduling boundaries.
+//
+// Constant shuffle of two tensors
+//
+def TT_DevShuffleOp : TT_Op<"dev.shuffle", [Pure]> {
+    let summary = "shuffle the elements of two tensors by a constant mask";
+    let description = [{
+      A dev op with the semantics of `vector.shuffle`. `v1` and `v2` have the
+      same element type, the same rank and the same sizes in every dimension
+      but the first. The result's first dimension has one entry per `mask`
+      element, and the rest of its shape is the operands' trailing shape.
+      Mask element `i` selects slice `i` of `v1` when `i < v1.shape[0]`,
+      slice `i - v1.shape[0]` of `v2` otherwise, and an undefined (poison)
+      slice when it is -1. A rank-1 shuffle therefore selects single
+      elements.
+
+      Example, a slide down by one element that shifts in a zero:
+
+      ```mlir
+      %r = tt.dev.shuffle %v, %zero [1, 2, 3, 4] : tensor<4xf16>, tensor<4xf16> -> tensor<4xf16>
+      ```
+    }];
+
+    let arguments = (ins TT_Tensor:$v1, TT_Tensor:$v2,
+                         DenseI64ArrayAttr:$mask);
+    let results = (outs TT_Tensor:$result);
+
+    let assemblyFormat = [{
+      $v1 `,` $v2 $mask attr-dict `:` type($v1) `,` type($v2) `->` type($result)
+    }];
+    let hasVerifier = 1;
+}
+
 def TT_DevSchedBarrierOp : TT_Op<"dev.sched_barrier",
                               [DeclareOpInterfaceMethods<
                                   MemoryEffectsOpInterface>]> {
diff --git a/lib/Dialect/Triton/IR/Ops.cpp b/lib/Dialect/Triton/IR/Ops.cpp
index 0faf5422fc..3d352a36b9 100644
--- a/lib/Dialect/Triton/IR/Ops.cpp
+++ b/lib/Dialect/Triton/IR/Ops.cpp
@@ -205,6 +205,31 @@ LogicalResult DevAllocOp::verify() {
   return success();
 }
 
+//-- DevShuffleOp --
+LogicalResult DevShuffleOp::verify() {
+  auto v1 = cast<RankedTensorType>(getV1().getType());
+  auto v2 = cast<RankedTensorType>(getV2().getType());
+  auto result = cast<RankedTensorType>(getResult().getType());
+  if (v1.getElementType() != v2.getElementType() ||
+      result.getElementType() != v1.getElementType())
+    return emitOpError("operands and result must have one element type");
+  if (v1.getRank() != v2.getRank() || result.getRank() != v1.getRank())
+    return emitOpError("operands and result must have one rank");
+  if (v1.getShape().drop_front() != v2.getShape().drop_front() ||
+      result.getShape().drop_front() != v1.getShape().drop_front())
+    return emitOpError("operands and result must agree in every dimension "
+                       "but the first");
+  ArrayRef<int64_t> mask = getMask();
+  if (static_cast<int64_t>(mask.size()) != result.getDimSize(0))
+    return emitOpError("result's first dimension must equal the mask size");
+  int64_t bound = v1.getDimSize(0) + v2.getDimSize(0);
+  for (int64_t index : mask)
+    if (index < -1 || index >= bound)
+      return emitOpError("mask element ")
+             << index << " is out of range [-1, " << bound << ")";
+  return success();
+}
