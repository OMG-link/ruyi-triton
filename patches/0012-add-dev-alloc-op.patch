index 615286a7c5..869a112603 100644
--- a/include/triton/Dialect/Triton/IR/TritonOps.td
+++ b/include/triton/Dialect/Triton/IR/TritonOps.td
@@ -625,6 +625,58 @@ def TT_GetNumProgramsOp : TT_Op<"get_num_programs", [Pure]> {
     }];
 }
 
+//
+// Per-program buffer allocation
+//
+def TT_DevAllocOp : TT_Op<"dev.alloc"> {
+    let summary = "allocate a buffer private to the program instance";
+    let description = [{
+      Allocates `num_elements` contiguous elements of the result's pointee
+      type and returns a pointer to the first element, aligned to at least
+      `alignment` bytes. The buffer is accessed through ordinary `tt.addptr`,
+      `tt.load` and `tt.store`.
+
+      Semantics:
+
+      - One allocation per program instance. The op must sit directly in the
+        body of a function, outside any loop or conditional, so that it runs
+        exactly once per program instance.
+      - The lifetime runs from the op to the end of the program instance.
+        Using the pointer after the program instance ends is undefined.
+      - The contents are uninitialized.
+      - The buffer is private to the program instance: no two program
+        instances share it, and the pointer must not be passed to another
+        program instance.
+
+      `placement` chooses the memory the buffer lives in:
+
+      - `global` (default): ordinary memory, the heap on CPU. On GPU it would
+        be global memory, carved per program instance from a buffer provided
+        by the runtime at launch.
+      - `local`: memory local to the program instance, its stack frame on
+        CPU.
+      - `spm`: scratchpad memory, the software-managed on-chip memory some
+        targets have (TCM, local data memory).
+
+      A backend that cannot place the buffer as requested rejects the op
+      rather than falling back to another placement.
+
+      Example:
+
+      ```mlir
+      %buf = tt.dev.alloc {alignment = 64 : i32, num_elements = 256 : i64} : !tt.ptr<f32>
+      ```
+    }];
+
+    let arguments = (ins I64Attr:$num_elements, I32Attr:$alignment,
+                         DefaultValuedAttr<TT_AllocPlacementAttr,
+                             "::mlir::triton::AllocPlacement::GLOBAL">:$placement);
+    let results = (outs Arg<TT_Ptr, "", [MemAlloc<GlobalMemory>]>:$result);
+
+    let assemblyFormat = "attr-dict `:` qualified(type($result))";
+    let hasVerifier = 1;
+}
+
 //
 // Dot Op
 //
