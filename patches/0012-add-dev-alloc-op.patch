diff --git a/python/triton/language/dev.py b/python/triton/language/dev.py
new file mode 100644
index 0000000000..ec56b1c385
--- /dev/null
+++ b/python/triton/language/dev.py
@@ -0,0 +1,62 @@
+"""Development operations: ``tl.dev``.
+
+These operations let a hand-written kernel state a decision the compiler
+will make on its own once the corresponding lowering exists (where a buffer
+lives, where scheduling must not cross, how registers are permuted). They are
+temporary: their interface may change or disappear, and only backends that
+implement them accept them.
+"""
+
+import builtins
+
+from .core import _unwrap_if_constexpr, builtin
+from .core import tuple as _tl_tuple
+
+__all__ = ["alloc"]
+
+
+@builtin
+def alloc(shape, dtype, alignment=None, placement="global", _semantic=None):
+    """
+    Allocates a buffer private to the current program instance and returns a
+    pointer to its first element.
+
+    The buffer holds :code:`prod(shape)` contiguous elements of :code:`dtype`
+    in row-major order and is accessed with ordinary :code:`tl.load` and
+    :code:`tl.store` through offsets from the returned pointer.
+
+    - There is one allocation per program instance. Call it at the top level
+      of the kernel, outside any loop or conditional.
+    - The buffer lives until the program instance ends.
+    - Its contents are uninitialized.
+    - It is private to the program instance and never shared with another one.
+
+    :code:`placement` chooses the memory the buffer lives in:
+    :code:`"global"` (the default; ordinary memory, the heap on CPU, and on
+    GPU global memory carved per program instance from a buffer provided by
+    the runtime), :code:`"local"` (memory local to the program instance, its
+    stack frame on CPU) or :code:`"spm"` (scratchpad memory, the
+    software-managed on-chip memory some targets have, such as TCM). A
+    backend that cannot honour the placement rejects the kernel instead of
+    falling back to another one.
+
+    :param shape: Number of elements, or a list of constant dimensions.
+    :type shape: int or tuple of ints
+    :param dtype: Element type, a scalar integer or floating-point type.
+    :type dtype: tl.dtype
+    :param alignment: Minimum alignment in bytes, a power of two. Defaults to
+        64, or the element size if larger.
+    :type alignment: int, optional
+    :param placement: :code:`"global"`, :code:`"local"` or :code:`"spm"`.
+    :type placement: str, optional
+    :rtype: pointer to :code:`dtype`
+    """
+    shape = _unwrap_if_constexpr(shape)
+    if isinstance(shape, _tl_tuple):
+        shape = shape.values
+    if isinstance(shape, (list, builtins.tuple)):
+        shape = [_unwrap_if_constexpr(d) for d in shape]
+    dtype = _unwrap_if_constexpr(dtype)
+    alignment = _unwrap_if_constexpr(alignment)
+    placement = _unwrap_if_constexpr(placement)
+    return _semantic.dev_alloc(shape, dtype, alignment, placement)
diff --git a/python/triton/language/semantic.py b/python/triton/language/semantic.py
index 1f12927ca4..8f49a5ec0b 100644
--- a/python/triton/language/semantic.py
+++ b/python/triton/language/semantic.py
@@ -46,6 +46,32 @@ class TritonSemantic(Generic[TensorTy]):
             raise ValueError(f"num_programs axis must be 0, 1, or 2 but got {axis}")
         return self.tensor(self.builder.create_get_num_programs(axis), tl.int32)
 
+    def dev_alloc(self, shape, dtype: tl.dtype, alignment, placement) -> TensorTy:
+        if isinstance(shape, int):
+            shape = [shape]
+        numel = 1
+        for d in shape:
+            if not isinstance(d, int) or d <= 0:
+                raise ValueError(f"alloc shape must contain positive constant integers, got {shape}")
+            numel *= d
+        if not isinstance(dtype, tl.dtype) or dtype.is_ptr() or not (dtype.is_int() or dtype.is_floating()):
+            raise ValueError(f"alloc dtype must be a scalar integer or float type, got {dtype}")
+        if alignment is None:
+            alignment = max(64, dtype.primitive_bitwidth // 8)
+        if not isinstance(alignment, int) or alignment <= 0 or alignment & (alignment - 1):
+            raise ValueError(f"alloc alignment must be a positive power of two, got {alignment}")
+        placements = {
+            "global": ir.ALLOC_PLACEMENT.GLOBAL,
+            "local": ir.ALLOC_PLACEMENT.LOCAL,
+            "spm": ir.ALLOC_PLACEMENT.SPM,
+        }
+        if placement not in placements:
+            raise ValueError(f"alloc placement must be 'global', 'local' or 'spm', got {placement!r}")
+        ptr_ty = tl.pointer_type(dtype)
+        return self.tensor(
+            self.builder.create_dev_alloc(ptr_ty.to_ir(self.builder), numel, alignment, placements[placement]),
+            ptr_ty)
+
