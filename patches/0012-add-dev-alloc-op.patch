+//-- DevAllocOp --
+LogicalResult DevAllocOp::verify() {
+  if (static_cast<int64_t>(getNumElements()) <= 0)
+    return emitOpError("num_elements must be positive");
+  uint32_t alignment = getAlignment();
+  if (alignment == 0 || !llvm::isPowerOf2_32(alignment))
+    return emitOpError("alignment must be a positive power of two");
+  auto ptrTy = cast<PointerType>(getType());
+  if (!ptrTy.getPointeeType().isIntOrFloat())
+    return emitOpError("pointee type must be a scalar integer or float");
+  if (!isa_and_nonnull<FunctionOpInterface>((*this)->getParentOp()))
+    return emitOpError("must sit directly in a function body, outside any "
+                       "loop or conditional");
+  return success();
+}
