diff --git a/python/triton/language/dev.py b/python/triton/language/dev.py
index d66105d673..eeaafcd0d3 100644
--- a/python/triton/language/dev.py
+++ b/python/triton/language/dev.py
@@ -98,9 +98,22 @@ class parallel(base_value):
     :param arg1: the start value, or the end value if ``arg2`` is not given.
     :param arg2: the end value.
     :param step: the step value, a positive integer.
+    :param schedule: how the iterations are handed to the threads:
+        ``"static"`` (the default, as OpenMP's ``schedule(static)``: each
+        thread one contiguous range, the first ``n % num_warps`` threads one
+        iteration more) or ``"round-robin"`` (thread ``t`` runs iterations
+        ``t, t + num_warps, ...``). Use :code:`tl.dev.warp_id()`, not the
+        iteration, to index per-warp resources under either.
     """
 
-    def __init__(self, arg1, arg2=None, step=None):
+    SCHEDULES = ("static", "round-robin")
+
+    def __init__(self, arg1, arg2=None, step=None, schedule="static"):
+        schedule = _unwrap_if_constexpr(schedule)
+        if schedule not in self.SCHEDULES:
+            raise ValueError(f"tl.dev.parallel schedule must be one of {self.SCHEDULES}, "
+                             f"got {schedule!r}")
+        self.schedule = schedule
         self.step = constexpr(1) if step is None else step
         if arg2 is None:
             self.start = constexpr(0)
