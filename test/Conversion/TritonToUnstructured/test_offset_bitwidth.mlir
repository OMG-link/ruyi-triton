// CHECK-LABEL: tt.func public @pointer_arithmetic_boundary
// CHECK-DAG: %[[POINTER:.*]] = arith.constant 2147483655 : index
// CHECK-DAG: %[[INTEGER:.*]] = arith.constant -2147483641 : index
// CHECK: tts.gather %arg0[%[[POINTER]]] : (<i8>, index) -> i8
// CHECK: tts.gather %arg0[%[[INTEGER]]] : (<i8>, index) -> i8
module {
  tt.func public @pointer_arithmetic_boundary(%base: !tt.ptr<i8>) -> (i8, i8) {
    %max = arith.constant 2147483647 : i32
    %eight = arith.constant 8 : i32
    %first = tt.addptr %base, %max : !tt.ptr<i8>, i32
    %nested = tt.addptr %first, %eight : !tt.ptr<i8>, i32
    %sum = arith.addi %max, %eight : i32
    %explicit = tt.addptr %base, %sum : !tt.ptr<i8>, i32
    %a = tt.load %nested : !tt.ptr<i8>
    %b = tt.load %explicit : !tt.ptr<i8>
    tt.return %a, %b : i8, i8
  }
}

// CHECK-LABEL: tt.func public @negative_pointer_arithmetic_boundary
// CHECK-DAG: %[[NEG_POINTER:.*]] = arith.constant -2147483656 : index
// CHECK-DAG: %[[NEG_INTEGER:.*]] = arith.constant 2147483640 : index
// CHECK: tts.gather %arg0[%[[NEG_POINTER]]] : (<i8>, index) -> i8
// CHECK: tts.gather %arg0[%[[NEG_INTEGER]]] : (<i8>, index) -> i8
module {
  tt.func public @negative_pointer_arithmetic_boundary(%base: !tt.ptr<i8>) -> (i8, i8) {
    %min = arith.constant -2147483648 : i32
    %minus_eight = arith.constant -8 : i32
    %first = tt.addptr %base, %min : !tt.ptr<i8>, i32
    %nested = tt.addptr %first, %minus_eight : !tt.ptr<i8>, i32
    %sum = arith.addi %min, %minus_eight : i32
    %explicit = tt.addptr %base, %sum : !tt.ptr<i8>, i32
    %a = tt.load %nested : !tt.ptr<i8>
    %b = tt.load %explicit : !tt.ptr<i8>
    tt.return %a, %b : i8, i8
  }
}
